---
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoSlot from '../components/DemoSlot.astro';
import ComponentRuntime from '../components/ComponentRuntime.astro';
import { components, componentsStatusNote } from '../data/components';
import { componentDemos } from '../data/component-demos';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Components"
  description="The OELTKit component gallery: the interaction components, the exact markup an LLM writes, their accessibility behavior, and the tracking they emit."
  path="/components/"
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Component gallery</span>
      <h1>The proof, one component at a time</h1>
      <p class="gallery-banner">
        Every component here is keyboard-operable and screen-reader tested. Try it — unplug your
        mouse.
      </p>

      <div class="todo-note" role="note">
        <p>
          <strong>Beta:</strong> the inventory and the markup below come straight from the toolkit's
          generated export (<a href="https://github.com/oeltkit/oeltkit">oeltkit/oeltkit</a>) — the
          same source the components ship from. Every component is
          <strong>{componentsStatusNote}</strong>. The markup is real, and the demos run live —
          <code>@oeltkit/components</code> is published (0.1.0). Two components
          (<code>&lt;oelt-media&gt;</code> and <code>&lt;oelt-hotspot&gt;</code>) need a sample
          media or image asset we don't ship, so they stay as static examples here.
        </p>
      </div>

      <div class="gallery">
        {
          components.map((c) => (
            <article class="card gallery__entry" aria-labelledby={`c-${c.tag}`}>
              <div class="gallery__head">
                <h2 id={`c-${c.tag}`} class="gallery__title">
                  <code>&lt;{c.tag}&gt;</code> <span class="gallery__label">{c.label}</span>
                </h2>
                <span class="gallery__status">{c.status}</span>
              </div>

              {c.elements.length > 1 && (
                <p class="gallery__family">
                  Ships{' '}
                  {c.elements.map((e, i) => (
                    <>
                      {i > 0 ? ', ' : ''}
                      <code>&lt;{e}&gt;</code>
                    </>
                  ))}
                  .
                </p>
              )}

              <DemoSlot component={c.tag} pending={componentDemos[c.tag]?.pending}>
                {componentDemos[c.tag]?.html && (
                  <Fragment set:html={componentDemos[c.tag].html} />
                )}
              </DemoSlot>

              <details class="gallery__details">
                <summary>View source — the exact markup an LLM writes</summary>
                <pre tabindex="0">
                  <code>{c.example}</code>
                </pre>
              </details>

              <details class="gallery__details">
                <summary>Accessibility — how it behaves without a mouse</summary>
                <p class="gallery__a11y">{c.a11y}</p>
              </details>

              <p class="gallery__foot">
                Emits a single <code>oelt-interaction</code> the runtime forwards to your LMS — see
                the <a href={withBase('/docs/tracking-guide/')}>tracking guide</a>.
                {c.docsPath ? (
                  <>
                    {' '}
                    <a href={withBase(c.docsPath)}>
                      Read the <code>&lt;{c.tag}&gt;</code> reference →
                    </a>
                  </>
                ) : (
                  <>
                    {' '}
                    <a href={withBase('/docs/components/')}>See the component reference →</a>
                  </>
                )}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <ComponentRuntime />
</BaseLayout>

<style>
  .gallery-banner {
    font-size: var(--oelt-text-lg);
    border-left: var(--oelt-space-2xs) solid var(--oelt-color-accent);
    padding-left: var(--oelt-space-lg);
  }

  .todo-note {
    margin-block: var(--oelt-space-lg);
    max-width: var(--oelt-measure);
  }

  .gallery {
    display: grid;
    gap: var(--oelt-space-xl);
    margin-top: var(--oelt-space-xl);
  }

  .gallery__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--oelt-space-sm);
    flex-wrap: wrap;
  }

  .gallery__title code {
    background: none;
    color: var(--oelt-color-accent);
  }

  .gallery__label {
    font-weight: 400;
    color: var(--oelt-color-ink-soft);
    font-size: var(--oelt-text-md);
  }

  .gallery__status {
    flex: none;
    font-family: var(--oelt-font-mono);
    font-size: var(--oelt-text-xs);
    letter-spacing: var(--oelt-tracking-wide);
    text-transform: uppercase;
    color: var(--oelt-color-warn-ink);
    background: var(--oelt-color-warn-bg);
    border: var(--oelt-border-w) solid var(--oelt-color-warn-line);
    border-radius: var(--oelt-radius-pill);
    padding: 0.15rem 0.6rem;
  }

  .gallery__family {
    font-size: var(--oelt-text-sm);
    color: var(--oelt-color-ink-soft);
    margin: 0 0 var(--oelt-space-sm);
  }

  .gallery__details {
    border-top: var(--oelt-border-w) solid var(--oelt-color-line);
    padding-block: var(--oelt-space-sm);
    margin-top: var(--oelt-space-sm);
  }

  .gallery__details summary {
    cursor: pointer;
    font-weight: 700;
    font-size: var(--oelt-text-sm);
  }

  .gallery__details summary:hover {
    color: var(--oelt-color-accent);
  }

  .gallery__a11y {
    margin: var(--oelt-space-sm) 0 0;
    font-size: var(--oelt-text-sm);
    color: var(--oelt-color-ink-soft);
    max-width: var(--oelt-measure);
  }

  .gallery__foot {
    margin: var(--oelt-space-md) 0 0;
    font-size: var(--oelt-text-sm);
    color: var(--oelt-color-ink-soft);
  }
</style>
