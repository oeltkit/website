# Live component demos. @oeltkit/components is now published (0.1.0) and a
# dependency, so demos are on for published builds (CI build + deploy set this
# to "true"). Set it to "false" to build the honest "coming with v0.1"
# placeholder path — e.g. when checking the no-demos fallback.
DEMOS_ENABLED=true

# Deploy-target switching (defaults suit local dev; CI sets these).
# GitHub Pages project site example:
#   SITE_URL=https://oeltkit.github.io
#   BASE_PATH=/website
# Cloudflare Pages example:
#   SITE_URL=https://oeltkit.pages.dev
#   BASE_PATH=/
#SITE_URL=
#BASE_PATH=
