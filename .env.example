# Component demos stay off until @oeltkit/components is on npm.
# Flip to "true" (plus add the dependency) to render live demos in the
# DemoSlot components — no page rebuild needed.
DEMOS_ENABLED=false

# Deploy-target switching (defaults suit local dev; CI sets these).
# GitHub Pages project site example:
#   SITE_URL=https://oeltkit.github.io
#   BASE_PATH=/website
# Cloudflare Pages example:
#   SITE_URL=https://oeltkit.pages.dev
#   BASE_PATH=/
#SITE_URL=
#BASE_PATH=
